{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arsiaprotocol.org/schemas/v2.0/arsia-message.schema.json",
  "$comment": "Copyright 2025-2026 Arsia Labs (Arsia Tecnologia Unipessoal Lda). Licensed under Apache 2.0. See licenses/LICENSE-ARTIFACTS.md.",
  "title": "ARSIA Message",
  "description": "Message envelope for the ARSIA Protocol wire version 2.0. Runtime constraints not expressible in JSON Schema: (1) When a receiving agent downgrades capabilities (Actions §1.3), the response MUST include effective_capabilities in payload.result. This array MUST be a subset of the original request's capabilities and MUST contain at least one capability. Enforced at runtime — schema cannot validate cross-message state. (2) Rollback requests (Actions §4.2) use intent 'request' with payload.type formatted as '{action_id}/rollback'. The payload.args SHOULD include original_message_id. This is a naming convention, not a distinct wire format. (3) Long-running actions (Actions §4.3) SHOULD use the asynchronous execution pattern. The initial response uses intent 'response' with payload.result containing status_url. Status polling responses are separate HTTP GET responses outside the ARSIA message envelope.",
  "type": "object",
  "$defs": {
    "transport-error-response": {
      "type": "object",
      "description": "Machine-readable transport-level error body per Core §11.1.1. Used for HTTP-level errors (401, 403, etc.) outside the ARSIA message envelope.",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "description": "HTTP status code"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable error reason"
        }
      }
    },
    "error-details-forbidden": {
      "type": "object",
      "description": "Error details for forbidden — Core §6.4, §11.2",
      "required": [
        "required_capabilities",
        "provided_capabilities"
      ],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All capabilities from the message's capabilities field"
        },
        "provided_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Capabilities present in the token's scope"
        }
      }
    },
    "error-details-not-implemented": {
      "type": "object",
      "description": "Error details for not_implemented — Core §11.2",
      "required": [
        "supported_versions"
      ],
      "properties": {
        "supported_versions": {
          "type": "object",
          "description": "Supported protocol version range",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            },
            "max": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            }
          },
          "additionalProperties": false
        },
        "unsupported_type": {
          "type": "string",
          "description": "SHOULD be included when error is due to unsupported payload type — Core §11.2"
        }
      }
    },
    "error-details-service-unavailable-residency": {
      "type": "object",
      "description": "Error details for service_unavailable caused by data residency violation — Core §11.2, Routing §1.2.2, §7.3 Rule 2",
      "required": [
        "data_residency_violation",
        "required_zone"
      ],
      "properties": {
        "data_residency_violation": {
          "type": "boolean",
          "const": true
        },
        "required_zone": {
          "$ref": "arsia-common.schema.json#/$defs/iso-3166-1-alpha-2"
        },
        "broker_jurisdiction": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/iso-3166-1-alpha-2"
            },
            {
              "description": "Broker's actual jurisdiction when rejecting for zone mismatch — Routing §7.3 Rule 2"
            }
          ]
        },
        "available_zones": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Zones the implementation can serve — Routing §1.2.2"
        }
      }
    },
    "error-details-certificate": {
      "type": "object",
      "description": "Error details for certificate errors (certificate_invalid, certificate_expired, key_mismatch, certificate_revoked) — Identity §6.4.3",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable explanation of the certificate verification failure"
        }
      }
    },
    "error-details-relay-failed": {
      "type": "object",
      "description": "Error details for broker relay failure — Routing §2.3.3, §7.3",
      "required": [
        "relay_failed",
        "relay_id"
      ],
      "properties": {
        "relay_failed": {
          "type": "boolean",
          "const": true
        },
        "relay_id": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/uuid-v4"
            },
            {
              "description": "Unique identifier for the relay operation"
            }
          ]
        },
        "reason": {
          "type": "string",
          "description": "Relay failure reason (e.g. relay_timeout) — Routing §2.3.4"
        },
        "original_error": {
          "type": "object",
          "description": "Recipient's error when relay failed due to recipient error",
          "properties": {
            "code": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    },
    "error-details-rate-limited": {
      "type": "object",
      "description": "Error details for rate_limited — Core §11.2. All fields SHOULD-level.",
      "properties": {
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "reset_at": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
            },
            {
              "description": "Timestamp when the rate limit resets"
            }
          ]
        }
      }
    },
    "error-details-payload-too-large": {
      "type": "object",
      "description": "Error details for payload_too_large — Core §11.2. All fields SHOULD-level.",
      "properties": {
        "max_message_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "actual_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error-details-conflict-version": {
      "type": "object",
      "description": "Error details for conflict caused by optimistic concurrency — State §8.4",
      "required": [
        "current_version",
        "expected_version"
      ],
      "properties": {
        "current_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
        },
        "updated_by": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/agent-id"
            }
          ]
        }
      }
    },
    "error-details-oversight-denied": {
      "type": "object",
      "description": "Error details for forbidden caused by human oversight denial — Actions §3.4 Path 2, §6 ACTIONS-06",
      "required": [
        "oversight_decision",
        "approver_id",
        "reason"
      ],
      "properties": {
        "oversight_decision": {
          "type": "string",
          "const": "denied"
        },
        "approver_id": {
          "type": "string",
          "minLength": 1,
          "description": "Agent-id of the approver who denied the action"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable reason from the approval_decision, or null"
        }
      }
    },
    "error-details-oversight-expired": {
      "type": "object",
      "description": "Error details for forbidden caused by approval deadline expiry — Actions §3.4 Path 3, §6 ACTIONS-07",
      "required": [
        "oversight_decision",
        "deadline"
      ],
      "properties": {
        "oversight_decision": {
          "type": "string",
          "const": "expired"
        },
        "deadline": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
            },
            {
              "description": "The approval_deadline timestamp that was exceeded"
            }
          ]
        }
      }
    },
    "error-details-rollback-conflict": {
      "type": "object",
      "description": "Error details for conflict when rolling back an already rolled-back action — Actions §4.2",
      "required": [
        "already_rolled_back"
      ],
      "properties": {
        "already_rolled_back": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "error-details-rollback-partial": {
      "type": "object",
      "description": "Details for partial rollback response — Actions §4.2",
      "required": [
        "partial_rollback",
        "rolled_back",
        "not_rolled_back"
      ],
      "properties": {
        "partial_rollback": {
          "type": "boolean",
          "const": true
        },
        "rolled_back": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Effects that were successfully reversed"
        },
        "not_rolled_back": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Effects that could not be reversed"
        }
      }
    },
    "pending-approval-args": {
      "type": "object",
      "description": "Payload args for pending_approval intent — Actions §3.2",
      "required": [
        "action_id",
        "original_request_id",
        "approval_deadline",
        "approver_capability",
        "context",
        "risk_level"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "description": "The action_id from the ActionDescriptor"
        },
        "original_request_id": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/uuid-v4"
            },
            {
              "description": "The id of the original request message"
            }
          ]
        },
        "approval_deadline": {
          "allOf": [
            {
              "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
            },
            {
              "description": "Latest time approval will be accepted — must equal envelope expires_at"
            }
          ]
        },
        "approver_capability": {
          "type": "string",
          "minLength": 1,
          "description": "Capability required to approve (v1.0: arsiaprotocol.oversight.approve)"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Human-readable description of the action for the approver"
        },
        "risk_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Risk level from the ActionDescriptor"
        }
      }
    },
    "approval-decision-result": {
      "type": "object",
      "description": "Payload result for approval_decision intent (oversight) — Actions §3.3",
      "required": [
        "decision",
        "approver_id"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "denied"
          ],
          "description": "The oversight decision"
        },
        "approver_id": {
          "type": "string",
          "minLength": 1,
          "description": "Agent-id or identifier of the approving entity"
        },
        "reason": {
          "type": "string",
          "maxLength": 512,
          "description": "Human-readable explanation — RECOMMENDED when decision is denied"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Conditions attached to the approval"
        }
      }
    },
    "long-running-status": {
      "type": "object",
      "description": "Status response for long-running actions — Actions §4.3",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed"
          ],
          "description": "Current execution status"
        }
      }
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "to",
    "intent"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": "2.0",
      "description": "Protocol version — this schema validates the 2.0 wire exactly (Core §4.1.1 version handling model)"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Message identifier (UUID v4) Uppercase hex accepted; implementations SHOULD produce lowercase (Core §4.1.2)."
    },
    "ts": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
        },
        {
          "description": "Timestamp (RFC 3339 with milliseconds)"
        }
      ]
    },
    "from": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/agent-id"
        }
      ],
      "description": "Sender agent identifier"
    },
    "to": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/agent-id"
        }
      ],
      "description": "Recipient agent identifier"
    },
    "intent": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "event",
        "error",
        "pending_approval",
        "approval_decision"
      ]
    },
    "correlation_id": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/uuid-v4"
        },
        {
          "description": "Correlation identifier: the id of the immediately preceding message in the interaction (immediate causal parent), per Core §4.2.1"
        }
      ]
    },
    "root_request_id": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/uuid-v4"
        },
        {
          "$comment": "Draft-02: REQUIRED whenever correlation_id is required; the conditional requirement is enforced from the v2 vector regeneration onward (Core §4.2.4)",
          "description": "Root request identifier: the id of the request that initiated the interaction, per Core §4.2.4"
        }
      ]
    },
    "expires_at": {
      "allOf": [
        {
          "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
        },
        {
          "description": "Expiration timestamp (RFC 3339 with milliseconds)"
        }
      ]
    },
    "min_v": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Minimum protocol version supported"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "arsia-common.schema.json#/$defs/capability-name"
          },
          {
            "maxLength": 128
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Requested capabilities"
    },
    "idempotency": {
      "type": "object",
      "required": [
        "key",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[ -~]+$"
        },
        "expires_at": {
          "$ref": "arsia-common.schema.json#/$defs/rfc3339-ms-utc"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "description": "W3C Trace Context trace-id: 32 lowercase hex characters; the all-zero value is invalid. ARSIA-Core.md §4.3.3."
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "not": {
            "const": "0000000000000000"
          },
          "description": "W3C Trace Context parent-id (span id): 16 lowercase hex characters; the all-zero value is invalid. ARSIA-Core.md §4.3.3."
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "locale": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "alg",
        "kid",
        "sig"
      ],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "EdDSA",
            "ES256",
            "RS256"
          ]
        },
        "kid": {
          "type": "string"
        },
        "sig": {
          "type": "string"
        },
        "encrypted": {
          "type": "boolean",
          "default": false
        },
        "enc_alg": {
          "type": "string",
          "description": "JWE key agreement algorithm (Core §5.3). RECOMMENDED: ECDH-ES. Also permitted: ECDH-ES+A256KW (MAY), RSA-OAEP-256 (MAY). Implementations SHOULD default to ECDH-ES unless interoperability requires an alternative."
        },
        "enc_method": {
          "type": "string",
          "description": "JWE content encryption algorithm (Core §5.3). The only defined value is A256GCM. Future spec versions may define additional methods."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "encrypted": {
                "const": true
              }
            },
            "required": [
              "encrypted"
            ]
          },
          "then": {
            "required": [
              "alg",
              "kid",
              "sig",
              "enc_alg",
              "enc_method"
            ]
          }
        }
      ]
    },
    "compliance": {
      "$ref": "arsia-compliance-field.schema.json",
      "description": "Compliance metadata (Core §4.3.6) — single source: arsia-compliance-field.schema.json (Draft-02 dedup; envelope-level cross-field rules remain in this schema's allOf)"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "arsia-common.schema.json#/$defs/payload-type"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            },
            "args": {},
            "result": {},
            "data": {},
            "explanation": {
              "$ref": "arsia-explanation.schema.json"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "args",
                  "result"
                ]
              },
              {
                "required": [
                  "args",
                  "data"
                ]
              },
              {
                "required": [
                  "result",
                  "data"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "error": {
              "type": "object",
              "required": [
                "code",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": [
                        "invalid_request",
                        "unauthorized",
                        "forbidden",
                        "not_found",
                        "conflict",
                        "payload_too_large",
                        "rate_limited",
                        "internal_error",
                        "not_implemented",
                        "service_unavailable",
                        "certificate_invalid",
                        "certificate_expired",
                        "key_mismatch",
                        "certificate_revoked"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
                    }
                  ],
                  "description": "Standard ARSIA error code or application-specific code in reverse domain notation. Standard codes use snake_case (e.g. invalid_request). Custom codes use dot-separated reverse domain notation with hyphens (e.g. com.example.insufficient-funds). Per ARSIA-Core.md §11.2."
                },
                "description": {
                  "type": "string"
                },
                "details": {
                  "type": "object"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "forbidden"
                      }
                    },
                    "required": [
                      "code"
                    ]
                  },
                  "then": {
                    "required": [
                      "details"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "forbidden"
                      },
                      "details": {
                        "required": [
                          "required_capabilities"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "details"
                    ]
                  },
                  "then": {
                    "properties": {
                      "details": {
                        "$ref": "#/$defs/error-details-forbidden"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "forbidden"
                      },
                      "details": {
                        "properties": {
                          "oversight_decision": {
                            "const": "denied"
                          }
                        },
                        "required": [
                          "oversight_decision"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "details"
                    ]
                  },
                  "then": {
                    "properties": {
                      "details": {
                        "$ref": "#/$defs/error-details-oversight-denied"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "forbidden"
                      },
                      "details": {
                        "properties": {
                          "oversight_decision": {
                            "const": "expired"
                          }
                        },
                        "required": [
                          "oversight_decision"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "details"
                    ]
                  },
                  "then": {
                    "properties": {
                      "details": {
                        "$ref": "#/$defs/error-details-oversight-expired"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "conflict"
                      },
                      "details": {
                        "properties": {
                          "already_rolled_back": {
                            "const": true
                          }
                        },
                        "required": [
                          "already_rolled_back"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "details"
                    ]
                  },
                  "then": {
                    "properties": {
                      "details": {
                        "$ref": "#/$defs/error-details-rollback-conflict"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "code": {
                        "const": "not_implemented"
                      }
                    },
                    "required": [
                      "code"
                    ]
                  },
                  "then": {
                    "properties": {
                      "details": {
                        "$ref": "#/$defs/error-details-not-implemented"
