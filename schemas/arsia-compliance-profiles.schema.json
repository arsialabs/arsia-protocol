{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arsiaprotocol.org/schemas/v2.0/arsia-compliance-profiles.schema.json",
  "$comment": "Copyright 2025-2026 Arsia Labs (Arsia Tecnologia Unipessoal Lda). Licensed under Apache 2.0. See licenses/LICENSE-ARTIFACTS.md.",
  "title": "ARSIA Compliance Profiles",
  "description": "Schema for the ARSIA Protocol compliance profiles registry. Validates the structure of arsia-compliance-profiles.json.",
  "type": "object",
  "required": [
    "version",
    "generated",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      },
      "minProperties": 1
    },
    "$comment": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "name",
        "description",
        "status",
        "regulatory_references",
        "defaults"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "draft",
            "deprecated"
          ]
        },
        "regulatory_references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "defaults": {
          "type": "object",
          "required": [
            "audit_required",
            "retention_minimum",
            "retention_basis",
            "human_oversight",
            "explainability_required",
            "pii_involved",
            "data_residency"
          ],
          "properties": {
            "audit_required": {
              "type": "boolean"
            },
            "human_oversight": {
              "type": "string",
              "enum": [
                "not_required",
                "required_before_execution",
                "required_within_24h",
                "required_post_execution"
              ]
            },
            "explainability_required": {
              "type": "boolean"
            },
            "pii_involved": {
              "type": "boolean"
            },
            "data_residency": {
              "type": [
                "string",
                "null"
              ]
            },
            "legal_basis": {
              "type": "string",
              "enum": [
                "consent",
                "contract",
                "legal_obligation",
                "vital_interests",
                "public_task",
                "legitimate_interests"
              ]
            },
            "clock_skew_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 300,
              "description": "Clock skew tolerance in seconds for timestamp validation. Overrides the Core §8.3 default of 300 seconds. MUST NOT exceed 300 — profiles can only tighten the tolerance. When absent, the 300-second default applies. Per ARSIA-Core.md §8.3."
            },
            "retention_minimum": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^P(?=[0-9])([0-9]+Y)?([0-9]+M)?([0-9]+D)?$",
              "description": "Profile retention minimum as an ISO 8601 calendar duration (ARSIA-Core.md §4.3.6.4), or null when the profile defines no floor."
            },
            "retention_basis": {
              "type": "string",
              "enum": [
                "regulatory",
                "profile_floor",
                "technical_default",
                "conservative_policy"
              ],
              "description": "Nature of the retention minimum: a mapped legal obligation, an ARSIA profile floor, a technical default, or a conservative policy choice."
            },
            "retention_reference": {
              "type": "string",
              "description": "Regulatory reference for the retention minimum (e.g. 'EU-AI-ACT:26(6)')."
            },
            "retention_interpretation": {
              "type": "string",
              "enum": [
                "calendar-duration",
                "day-count"
              ],
              "description": "Whether the underlying obligation is a calendar period or a day count."
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
