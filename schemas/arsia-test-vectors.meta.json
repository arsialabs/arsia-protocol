{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arsiaprotocol.org/schemas/v2.0/arsia-test-vectors.meta.json",
  "$comment": "Copyright 2025-2026 Arsia Labs (Arsia Tecnologia Unipessoal Lda). Licensed under Apache 2.0. See licenses/LICENSE-ARTIFACTS.md.",
  "title": "ARSIA Protocol Test Vectors",
  "description": "Meta-schema validating the structure of arsia-test-vectors.json",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "generated",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://arsiaprotocol.org/schemas/test-vectors/v1.0.json"
    },
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "vectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test-vector"
      }
    }
  },
  "$defs": {
    "test-vector": {
      "type": "object",
      "required": [
        "id",
        "description",
        "expected_error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d+$"
        },
        "description": {
          "type": "string"
        },
        "expected_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "core",
            "identity",
            "actions",
            "state",
            "routing",
            "assets"
          ]
        },
        "crypto": {
          "type": "object",
          "required": [
            "private_key_hex",
            "public_key_hex",
            "canonical_bytes_hex",
            "signature_base64url",
            "expect_signature"
          ],
          "additionalProperties": false,
          "properties": {
            "expect_signature": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "absent"
              ],
              "description": "Expected outcome of signature verification, independent of valid/expected/expected_error. valid: security.sig is present and MUST verify (Core §5.2 Step 5). invalid: security.sig is present and MUST fail (signature negative). absent: the message deliberately carries no security object; only canonical_bytes_hex is checked, which is not signature verification."
            },
            "private_key_hex": {
              "type": "string"
            },
            "public_key_hex": {
              "type": "string"
            },
            "canonical_bytes_hex": {
              "type": "string"
            },
            "signature_base64url": {
              "type": "string"
            }
          }
        },
        "skip_schema": {
          "type": "boolean",
          "const": true
        },
        "skip_reason": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "expected": {
          "type": "string",
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "message": {
          "type": "object"
        },
        "data": {
          "type": "object"
        },
        "schema_ref": {
          "type": "string"
        },
        "test_metadata": {
          "type": "object",
          "description": "Auxiliary context for runtime-only test vectors (e.g., token_scope, authorization context). Not used by schema validation."
        },
        "posture": {
          "type": "object",
          "description": "Declared posture of a vector whose expected outcome rests on an option the protocol permits but does not require (DR-0.3): a MAY, or an optional configuration. The expectation holds for an implementation that takes the option stated in assumes.",
          "required": [
            "spec",
            "section",
            "basis",
            "text",
            "assumes"
          ],
          "additionalProperties": false,
          "properties": {
            "spec": {
              "type": "string",
              "enum": [
                "ARSIA-Core.md",
                "ARSIA-Actions.md",
                "ARSIA-Routing.md",
                "ARSIA-State.md",
                "ARSIA-Identity.md",
                "ARSIA-Assets.md"
              ]
            },
            "section": {
              "type": "string",
              "pattern": "^§\\d+(\\.\\d+)*$"
            },
            "basis": {
              "type": "string",
              "enum": [
                "MAY",
                "configuration"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Verbatim phrase of the cited section that grants the option."
            },
            "assumes": {
              "type": "string",
              "minLength": 1,
              "description": "The option the vector's expectation takes."
            }
          }
        },
        "signature_expectation": {
          "type": "object",
          "description": "Declared signature negative of a vector WITHOUT a crypto block (Draft-01.1 port): the envelope's security.sig is expected NOT to pass verification, for the stated cause and condition. Absent, a present security.sig MUST verify mathematically with the catalog key of its kid (test-vectors/keypairs.json). It does not change valid, expected or expected_error.",
          "additionalProperties": false,
          "required": [
            "result",
            "cause",
            "condition"
          ],
          "properties": {
            "result": {
              "const": "invalid"
            },
            "cause": {
              "enum": [
                "kid",
                "alg",
                "key",
                "signature"
              ]
            },
            "condition": {
              "enum": [
                "binding",
                "unresolved",
                "not-allowed",
                "incompatible",
                "size",
                "length",
                "mismatch"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "cause": {
                    "const": "kid"
                  }
                }
              },
              "then": {
                "properties": {
                  "condition": {
                    "enum": [
                      "binding",
                      "unresolved"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "cause": {
                    "const": "alg"
                  }
                }
              },
              "then": {
                "properties": {
                  "condition": {
                    "enum": [
                      "not-allowed",
                      "incompatible"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "cause": {
                    "const": "key"
                  }
                }
              },
              "then": {
                "properties": {
                  "condition": {
                    "const": "size"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "cause": {
                    "const": "signature"
                  }
                }
              },
              "then": {
                "properties": {
                  "condition": {
                    "enum": [
                      "length",
                      "mismatch"
                    ]
                  }
                }
              }
            }
          ]
        },
        "raw_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$",
          "description": "Exact received bytes, lowercase hex with an even number of digits. Raw vectors exercise only the Core §5.2 pipeline steps 2-4 (parse, I-JSON, duplicate member names): accepting them establishes well-formed I-JSON text, not a valid, authenticated or authorized message. A test-corpus format, not an ARSIA envelope."
        },
        "expected_parse": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ],
          "description": "Expected outcome of Core §5.2 steps 2-4 on raw_hex; a rejection is invalid_request (expected_error)."
        }
      },
      "dependentRequired": {
        "skip_schema": [
          "skip_reason"
        ],
        "raw_hex": [
          "expected_parse"
        ],
        "expected_parse": [
          "raw_hex"
        ]
      },
      "oneOf": [
        {
          "title": "message-only",
          "description": "Full message validated against arsia-message.schema.json",
          "required": [
            "message",
            "valid"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "schema_ref"
                ]
              },
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "raw_hex"
                ]
              },
              {
                "required": [
                  "expected_parse"
                ]
              }
            ]
          }
        },
        {
          "title": "schema-ref",
          "description": "Data payload validated against a named schema",
          "required": [
            "schema_ref",
            "data",
            "expected"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "message"
                ]
              },
              {
                "required": [
                  "valid"
                ]
              },
              {
                "required": [
                  "raw_hex"
                ]
              },
              {
                "required": [
                  "expected_parse"
                ]
              }
            ]
          }
        },
        {
          "title": "hybrid",
          "description": "Full message validated against a named schema (e.g. sub-schema)",
          "required": [
            "schema_ref",
            "message",
            "expected"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "valid"
                ]
              },
              {
                "required": [
                  "raw_hex"
                ]
              },
              {
                "required": [
                  "expected_parse"
                ]
              }
            ]
          }
        },
        {
          "title": "raw",
          "description": "Exact received bytes, checked by the Core §5.2 pipeline steps 2-4 only (parse, I-JSON, duplicate names). A test-corpus format, not an ARSIA envelope.",
          "required": [
            "raw_hex",
            "expected_parse"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "message"
                ]
              },
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "schema_ref"
                ]
              },
              {
                "required": [
                  "valid"
                ]
              },
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "crypto"
                ]
              }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_parse": {
                "const": "reject"
              }
            },
            "required": [
              "expected_parse"
            ]
          },
          "then": {
            "properties": {
              "expected_error": {
                "const": "invalid_request"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_parse": {
                "const": "accept"
              }
            },
            "required": [
              "expected_parse"
            ]
          },
          "then": {
            "properties": {
              "expected_error": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "signature_expectation"
            ]
          },
          "then": {
            "not": {
              "required": [
                "crypto"
              ]
            },
            "anyOf": [
              {
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "object",
                    "required": [
                      "security"
                    ],
                    "properties": {
                      "security": {
                        "type": "object",
                        "required": [
                          "sig"
                        ],
                        "properties": {
                          "sig": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "schema_ref",
                  "data"
                ],
                "properties": {
                  "schema_ref": {
                    "enum": [
                      "arsia-message.schema.json",
                      "arsia-relay-attestation.schema.json"
                    ]
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "security"
                    ],
                    "properties": {
                      "security": {
                        "type": "object",
                        "required": [
                          "sig"
                        ],
                        "properties": {
                          "sig": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
